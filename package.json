{
  "name": "cure-magic-miracle",
  "version": "0.0.1",
  "description": "(✿◡‿◡) 转生魔法少女正在攻略 JS -- 凝聚奇迹的魔法棒",
  "author": "Hosinoharu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hosinoharu/cure-magic-miracle.git"
  },
  "homepage": "https://github.com/Hosinoharu/cure-magic-miracle",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "prebuild": "npm run format",
    "build-only": "jiti build.ts",
    "dev-popup": "vite --mode popup",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli *.{json,ts} src/**/*.{ts,vue}"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.8.4",
    "typescript": "~6.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
